---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import "../styles/blog.css";

type Props = CollectionEntry<"blog">["data"];

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroImageCredit,
  authors,
  headings,
  published,
} = Astro.props;

const filteredHeadings = headings.filter((h: { depth: number; slug: string; text: string }) => h.depth <= 2);
const hasTableOfContents = filteredHeadings.length > 0;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
    <style></style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          {
            heroImage && (
              <>
                <img width={1020} height={510} src={heroImage} alt="" />
                <p class="subtitle">{heroImageCredit}</p>
              </>
            )
          }
        </div>

        <div class="prose">
          <div class="title">
                   {!published && <div class="draft-banner">DRAFT</div>}
            <div class="date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>

            <h1>{title}</h1>
            {
              authors && (
                <div class="authors">
                  <div>{authors}</div>
                </div>
              )
            }
          </div>
          {
            hasTableOfContents && (
              <div class="toc-section">
                <p class="subtitle">Table of Contents</p>
                <ul>
                  <li class="toc-item">
                    <a class="toc-link" href="#">Intro</a>
                  </li>
                  {filteredHeadings.map((heading: { slug: string; text: string }) => (
                    <li class="toc-item">
                      <a class="toc-link" href={`#${heading.slug}`}>
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          <slot />
        </div>
      
      </article>
    </main>

    <Footer />
  </body>
</html>
