---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
  <h2>
    <a href="/">{SITE_TITLE}</a>
  </h2>

  <nav>
    <HeaderLink href="/">Blog</HeaderLink>
    <HeaderLink href="/projects">Projects</HeaderLink>
    <HeaderLink href="/about">About</HeaderLink>
  </nav>
</header>

<style>
  header {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin: 0 0 1.5rem 0;
    padding: 0 1em;
  }

  header a {
    color: var(--black);
    text-decoration: none;
  }

  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
  }

  nav {
    align-items: center;
    display: flex;
	gap: 1rem;
  }

  nav a.active {
    text-decoration: none;
  }
</style>
