---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      .about {
        display: flex;
        gap: 2rem;
      }

      .about > div {
        flex-basis: 50%;
      }

      .about img {
        max-height: 25rem;
		margin-bottom: 1rem;
      }

      @media only screen and (max-device-width: 800px) {
        .about {
          display: block;
          gap: 2rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="about">
        <div>
          <img src="/images/streetscape.jpg" />
        </div>
        <div>
          <h4>Streets for All Data Dev Team</h4>
          <p>
            At Streets for All, we base our advocacy on real data and
            quantifiable evidence. Our Data/Dev Team, comprised of volunteer
            data scientists, GIS analysts, and web developers, synthesizes data
            pulled from a multitude of sources and presents it in intuitive web
            interfaces to tell accessible and compelling stories.
          </p>

          <a href="">Join the team</a>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
