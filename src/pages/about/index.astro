---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<style>
  .about {
    display: flex;
    gap: 2rem;
  }

  .about > div {
    flex-basis: 50%;
  }

  .about img {
    max-height: 25rem;
    margin-bottom: 1rem;
  }

  @media only screen and (max-device-width: 800px) {
    .about {
      display: block;
      gap: 2rem;
    }
  }
</style>

<BaseLayout>
  <div class="about">
    <div>
      <img src="/images/streetscape.jpg" />
    </div>

    <div>
      <h4>Streets for All Data Dev Team</h4>

      <p>
        At Streets for All, we base our advocacy on real data and quantifiable
        evidence. Our Data/Dev Team, comprised of volunteer data scientists, GIS
        analysts, and web developers, synthesizes data pulled from a multitude
        of sources and presents it in intuitive web interfaces to tell
        accessible and compelling stories.
      </p>

      <p>
        Email <a href="mailto:josh@streetsforall.org">josh@streetsforall.org</a>{' '}
        with questions or if you are interested in joining the team.
      </p>
    </div>
  </div>
</BaseLayout>
